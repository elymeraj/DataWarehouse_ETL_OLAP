<?xml version="1.0"?>
<Schema name="Ventes_Schema">

  <Cube name="Ventes" defaultMeasure="CA">
    <Table name="Vente" />

    <Dimension name="Date" foreignKey="cle_date_debut">
      <Hierarchy name="Standard" hasAll="true" primaryKey="date_complete">
        <Table name="Dates" />
        <Level name="Année" column="annee" uniqueMembers="true" />
        <Level name="Trimestre" column="trimestre" />
        <Level name="Mois" column="mois" />
        <Level name="Nom du Mois" column="nom_mois" ordinalColumn="mois" />
        <Level name="Jour du mois" column="jour_mois" />
        <Level name="Heure" column="heure" />
        <Level name="Minute" column="minute" />
      </Hierarchy>

      <Hierarchy name="Analyse par heure" hasAll="true" primaryKey="date_complete">
        <Table name="Dates" />
        <Level name="Heure" column="heure" />
        <Level name="Minute" column="minute" />
      </Hierarchy>

      <Hierarchy name="Analyse par jours" hasAll="true" primaryKey="date_complete">
        <Table name="Dates"/>
        <Level name="Jour" column="jour_mois" />
        <Level name="Nom jour" column="nom_jour" />
      </Hierarchy>
    </Dimension>

    <Dimension name="Client" foreignKey="id_technique">
      <Hierarchy name="ParNom" hasAll="true" primaryKey="id_technique">
        <Table name="Client" />
        <Level name="Nom" column="nom" />
        <Level name="Prénom" column="prenom" />
      </Hierarchy>
      
      <Hierarchy name="ParRégion" hasAll="true" primaryKey="id_technique">
        <Table name="Client" />
        <Level name="Région" column="region_nom" />
      </Hierarchy>

      <Hierarchy name="ParVille" hasAll="true" primaryKey="id_technique">
        <Table name="Client" />
        <Level name="Ville" column="ville" />
        <Level name="Département" column="department_nom" />
        <Level name="Région" column="region_nom" />
      </Hierarchy>
    </Dimension>

    <Dimension name="Prestation" foreignKey="cle_prestation">
      <Hierarchy name="ParCategorie" hasAll="true" primaryKey="cle_prestation">
        <Table name="Prestation" />
        <Level name="Catégorie" column="categorie_prestation" />
      </Hierarchy>
      <Hierarchy name="ParType" hasAll="true" primaryKey="cle_prestation">
        <Table name="Prestation" />
        <Level name="Type" column="nom_prestation" />
      </Hierarchy>
    </Dimension>

    <Dimension name="Localisation" foreignKey="id_localisation">
      <Hierarchy name="Standard" hasAll="true" primaryKey="id_localisation">
        <Table name="Localisation" />
        <Level name="Région" column="region_nom" />
        <Level name="Département" column="department_nom" />
        <Level name="Ville" column="ville" />
        <Level name="Code Postal" column="code_postal" />
      </Hierarchy>
    </Dimension>

    <Measure name="CA" column="prix" aggregator="sum" formatString="Standard" />
    <Measure name="Prix moyen" column="prix" aggregator="avg" formatString="Standard" /> 
    <Measure name="Durée moyenne d'intervention" column="duration" aggregator="avg" formatString="Standard" />
    <Measure name="Nombre de ventes" column="vente_id" aggregator="count" formatString="Standard" />


  </Cube>

</Schema>
